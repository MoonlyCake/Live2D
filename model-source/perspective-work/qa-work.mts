import{readFileSync,writeFileSync}from'node:fs';import{createCanvas,loadImage,ImageData}from'@napi-rs/canvas';import{parseContainer,decodeTGA,SubsetModel}from'../../src/shared/inochi-runtime.mjs';import{SoftwareMeshRenderer}from'../../src/renderer/inochi/software-renderer.mjs';import{homography,projectPoint}from'../../src/shared/perspective';import layout from'../../assets/keyboard.layout.json';
(globalThis as any).ImageData=ImageData;const dir='model-source/perspective-work/',contract=JSON.parse(readFileSync(dir+'rig-contract.json','utf8')),parsed=parseContainer(readFileSync(process.argv[2]||dir+'WhaleGirl-work-DRAFT.inx')),rig=new SubsetModel(parsed.model,parsed.textures.length);const names=new Map([...rig.nodes].map(([id,{n}]:any)=>[id,n.name]));const kh=homography(...contract.keyboard.logicalSize as[number,number],contract.keyboard.quad),mh=homography(...contract.mouse.logicalSize as[number,number],contract.mouse.quad);
function hand(h:any,target:number[],typing:boolean,pressed=0){const s=h.sleeve,ox=s.moving[0]-h.reference[0],oy=s.moving[1]-h.reference[1];let ha=typing?Math.atan2(s.fixed[1]-target[1],s.fixed[0]-target[0])-Math.atan2(oy,ox):0;ha=Math.atan2(Math.sin(ha),Math.cos(ha));const dx=target[0]+Math.cos(ha)*ox-Math.sin(ha)*oy-s.fixed[0],dy=target[1]+Math.sin(ha)*ox+Math.cos(ha)*oy-s.fixed[1],angle=Math.atan2(dy,dx)-s.baseAngle;return{[h.parameters.x]:target[0],[h.parameters.y]:target[1],[s.angleParameter]:Math.atan2(Math.sin(angle),Math.cos(angle)),[s.lengthParameter]:Math.hypot(dx,dy)/s.baseLength,...(typing?{ParamTypingActive:1,ParamTypingPressR:pressed,ParamTypingHandRAngle:ha}:{})}}

const keys=layout.keys.map(k=>({name:k.id,values:hand(contract.typingHand,projectPoint(kh,k.x-360,k.y-820+4),true,1)}));const cases:any[]=[...[0,.1,.25,.5,.65,.75,1].map(v=>({name:'eye '+v,values:{ParamEyeLOpen:v,ParamEyeROpen:v,ParamMouthOpenY:0,ParamMouthForm:-.3}})),...[0,.25,.5,1].map(v=>({name:'mouth '+v,values:{ParamMouthOpenY:v}}))];for(const id of ['Escape','KeyA','KeyF','KeyJ','Enter','Space','ArrowRight'])cases.push(keys.find(k=>k.name===id));for(const x of contract.mouse.travel.min.map((v:number,i:number)=>i===0?v:null).filter((v:any)=>v!==null)){};for(const x of [contract.mouse.travel.min[0],contract.mouse.home[0],contract.mouse.travel.max[0]])for(const y of [contract.mouse.travel.min[1],contract.mouse.home[1],contract.mouse.travel.max[1]])cases.push({name:'mouse '+Math.round(x)+','+Math.round(y),values:{...hand(contract.mouseHand,projectPoint(mh,x,y),false),ParamMouseLeft:1}});
for(const x of [-1,1])for(const y of [-1,1])cases.push({name:'gaze '+x+','+y,values:{ParamEyeBallX:x,ParamEyeBallY:y,ParamEyeLOpen:.25,ParamEyeROpen:.25}});
const area=(f:any,i:number)=>{const a=f.indices[i]*4,b=f.indices[i+1]*4,c=f.indices[i+2]*4,v=f.vertices;return(v[b]-v[a])*(v[c+1]-v[a+1])-(v[b+1]-v[a+1])*(v[c]-v[a])};let base=rig.frame(),folds:any[]=[];for(const c of [...keys,...cases]){const f=rig.frame(c.values);for(const cmd of f.commands){if(cmd.opacity===0)continue;for(let i=cmd.indexOffset;i<cmd.indexOffset+cmd.count;i+=3)if(area(base,i)*area(f,i)<-1e-4)folds.push({pose:c.name,part:names.get(cmd.partId)})}}writeFileSync(dir+'numeric-qa.json',JSON.stringify({keys:keys.length,poses:cases.length,folds:folds.slice(0,30),foldCount:folds.length},null,2));
const textures:any[]=[];for(const t of parsed.textures){let z:any;if(t.type===1)z=decodeTGA(t.bytes);else{const im=await loadImage(t.bytes),c=createCanvas(im.width,im.height),x=c.getContext('2d');x.drawImage(im,0,0);z={width:im.width,height:im.height,pixels:x.getImageData(0,0,im.width,im.height).data}}for(let i=0;i<z.pixels.length;i+=4)for(let j=0;j<3;j++)z.pixels[i+j]=Math.round(z.pixels[i+j]*z.pixels[i+3]/255);textures.push(z)}const canvas=createCanvas(700,458),renderer=new SoftwareMeshRenderer(canvas as any,{texture:(id:number)=>textures[id]});renderer.bounds={cx:0,cy:0,w:contract.canvas[0]*.72,h:contract.canvas[1]*.72};let sheet:any,ctx:any;for(let i=0;i<cases.length;i++){if(i%6===0){sheet=createCanvas(1400,1500);ctx=sheet.getContext('2d');ctx.fillStyle='#dddfe4';ctx.fillRect(0,0,1400,1500)}renderer.draw(rig.frame(cases[i].values));const x=i%2*700,y=Math.floor(i%6/2)*500;ctx.drawImage(canvas,x,y);ctx.fillStyle='#172f4e';ctx.font='22px sans-serif';ctx.fillText(cases[i].name,x+12,y+484);if(i===0||i===3||cases[i].name==='KeyJ')writeFileSync(dir+'pose-'+i+'.png',canvas.toBuffer('image/png'));if(i%6===5||i===cases.length-1)writeFileSync(dir+'poses-'+Math.floor(i/6)+'.png',sheet.toBuffer('image/png'));}console.log('Tested',keys.length,'keys and rendered',cases.length,'poses; fold count',folds.length);
