import assert from 'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{emptyMealVisibility,stepMealVisibility}from'../src/renderer/inochi';import{parseContainer,SubsetModel}from'../src/shared/inochi-runtime.mjs';
const {model,textures}=parseContainer(readFileSync('assets/inochi/WhaleGirl.inp'));const rig=new SubsetModel(model,textures.length);const names=new Map([...rig.nodes].map(([id,{n}])=>[id,n.name]));let count=0;const sequences=[];
for(const startArm of[0,.25,.5,.75,1])for(const bite of[0,1]){let s=stepMealVisibility(emptyMealVisibility(),true,0,startArm,bite);s=stepMealVisibility(s,false,100,0,0);const rows=[];for(const elapsed of[0,55,110,165,219,220,221,400]){s=stepMealVisibility(s,false,100+elapsed,0,0);const v={ParamRiceBowlOpacity:s.visible?1:0,ParamRicePoseSwitch:s.visible?1:0,ParamRiceArm:s.arm,ParamRiceBiteOpacity:s.bite};const f=rig.frame(v);const op=Object.fromEntries(f.commands.map(c=>[names.get(c.partId),c.opacity]));assert.equal(op.ForearmHandL+op.RiceHoldingArmBowl,1);assert.equal(op.ForearmHandR+op.RiceSpoonArmEmpty,1);assert([0,1].includes(op.ForearmHandL));assert([0,1].includes(op.RiceHoldingArmBowl));if(elapsed<220){assert.equal(s.visible,true);assert.equal(s.hidingSince,100);assert.equal(s.bite,bite)}else{assert.equal(s.visible,false);assert.equal(s.arm,0)}rows.push({elapsed,...s});count++}sequences.push({startArm,bite,rows})}
writeFileSync('docs/inochi/interruption-report.json',JSON.stringify({passed:count,sequences},null,2));console.log('Passed',count,'interruption states: 5 start arm positions ×2 bite states ×8 times, exactly two opaque hands, finite220ms completion');
