import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{createCanvas,ImageData,loadImage}from'@napi-rs/canvas';
import{parseContainer,decodeTGA,SubsetModel}from'../src/shared/inochi-runtime.mjs';import{SoftwareMeshRenderer}from'../src/renderer/inochi/software-renderer.mjs';import{DeviceSurface,insertDeviceQuad}from'../src/renderer/inochi/devices';import{physicalPose,PHYSICAL_PARAMETERS}from'../src/renderer/inochi/physical-pose';import{PhysicalInput}from'../src/shared/physical-input';import layout from'../assets/keyboard.layout.json';
(globalThis as any).OffscreenCanvas=class{constructor(w:number,h:number){return createCanvas(w,h)}};(globalThis as any).ImageData=ImageData;
const path=process.argv[2]||'assets/inochi/WhaleGirl.inp',p=parseContainer(readFileSync(path)),model=new SubsetModel(p.model,p.textures.length);for(const name of PHYSICAL_PARAMETERS)if(!model.params.some(v=>v.name===name&&v.bindings.length))throw Error('Missing physical rig parameter '+name);
const textures:any[]=[];for(const t of p.textures){let texture:any;if(t.type===1)texture=decodeTGA(t.bytes);else{const im=await loadImage(Buffer.from(t.bytes)),c=createCanvas(im.width,im.height),x=c.getContext('2d');x.drawImage(im,0,0);texture={width:im.width,height:im.height,pixels:x.getImageData(0,0,im.width,im.height).data}}for(let i=0;i<texture.pixels.length;i+=4)for(let j=0;j<3;j++)texture.pixels[i+j]=Math.round(texture.pixels[i+j]*texture.pixels[i+3]/255);textures.push(texture)}
const device=new DeviceSurface(),id=textures.length;textures.push(device.texture);const front=new Set<number>();for(const[id,{n}]of model.nodes)if(['TypingHandL','TypingHandR','MouseHandR'].includes(n.name))front.add(id);if(front.size!==3)throw Error('Missing working hand nodes');const c=createCanvas(320,420),r=new SoftwareMeshRenderer(c as any,{texture:(id:number)=>textures[id]});const input=new PhysicalInput(layout.keys,()=>1000);const out='docs/inochi/physical-qa';mkdirSync(out,{recursive:true});const sheet=createCanvas(320*4,420*2),ctx=sheet.getContext('2d');let cases=0;const evidence:any[]=[];
function render(name:string,index?:number){const state=input.snapshot(),values=physicalPose(state,true);device.update(state);r.updateTexture(id);const result=r.draw(insertDeviceQuad(model.frame(values),id,front,true));const pixels=r.readPixels();if(!pixels.some((v:number,i:number)=>i%4===3&&v>0))throw Error('Empty frame');if(index!==undefined){ctx.drawImage(c,index%4*320,Math.floor(index/4)*420);writeFileSync(out+'/'+name+'.png',c.toBuffer('image/png'))}evidence.push({name,left:state.targets.left,right:state.targets.right,handLX:values.ParamTypingHandLX,handLY:values.ParamTypingHandLY,handRX:values.ParamTypingHandRX,handRY:values.ParamTypingHandRY});cases++;}
for(const [i,k]of layout.keys.entries()){input.reset();input.keyDown(k.nativeCode);render(k.id,['KeyF','KeyJ','KeyA','Enter','ArrowRight','Space'].indexOf(k.id)>=0?['KeyF','KeyJ','KeyA','Enter','ArrowRight','Space'].indexOf(k.id):undefined);input.keyUp(k.nativeCode);if(input.snapshot().pressed.length)throw Error('Stuck '+k.id)}input.reset();input.move(-1,-1);input.buttonDown('left');render('mouse-left',6);input.reset();input.move(1,1);input.buttonDown('right');input.wheel(0,1);render('mouse-right-wheel',7);writeFileSync(out+'/contact-sheet.png',sheet.toBuffer('image/png'));writeFileSync(out+'/report.json',JSON.stringify({status:'passed',model:path,cases,backend:'CPU actual triangle rasterizer',syntheticPhysicalStates:true,notNativeKeyboardCapture:true,evidence},null,2));console.log('Passed',cases,'actual model/device renders; 83 per-key down/up and mouse corners.');
